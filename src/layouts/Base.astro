---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Toast from "../components/Toast.astro";
import { buildHash, buildDatum } from "../lib/build";
import { SITE_URL } from "../lib/site.mjs";
import logo from "../ascii-logo.txt?raw";

const { title, noindex = false, ogType = "website", ogImage = "/og/default.png", publishedTime, author, description = "Myst is een klein team senior cloud engineers. We ontwerpen, bouwen en automatiseren platformen op Azure, AWS en Google Cloud, voor organisaties die meer uit de cloud willen halen." } = Astro.props;
const pad = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  ["/engineers", "Engineers"],
  ["/werkwijze", "Werkwijze"],
  ["/workshops", "Workshops"],
  ["/werken-bij", "Werken bij"],
  ["/blog", "Blog"],
  ["/contact", "Contact"],
];
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogAfbeelding = new URL(ogImage, SITE_URL).href;
const huis = (href: string) => pad === href || pad.startsWith(href + "/");
const commentaar = `<!--
${logo.trimEnd()}

Je kijkt onder de motorkap. Dat waarderen we.
Benieuwd wat er nog meer te vinden is? https://shell.myst.nl
Gebouwd met Astro, zonder cookies: https://myst.nl/gebouwd
-->`;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1026" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Blog · Myst" href="/blog/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogAfbeelding} />
    <meta property="og:locale" content="nl_NL" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
    <ClientRouter />
  </head>
  <body>
    <Fragment set:html={commentaar} />
    <a href="#inhoud" class="sr-only">Naar de inhoud</a>
    <header class="wrap nav">
      <a href="/" aria-label="Myst home"><Logo /></a>
      <nav aria-label="Hoofdmenu">
        {nav.map(([href, naam]) => <a href={href} aria-current={huis(href) ? "page" : undefined}>{naam}</a>)}
        <a href="https://shell.myst.nl" target="_blank" rel="noopener" class="console">~ console</a>
      </nav>
    </header>
    <main id="inhoud"><slot /></main>
    <footer class="voet" id="footer">
      <div class="wrap voet__kolommen">
        <div class="voet__kolom">
          <Logo />
          <p>Symfonielaan 26<br />3438 EV Nieuwegein<br />030 227 1973<br />info@myst.nl<br />KvK 91802938<a href="https://www.normeringarbeid.nl/snakeurmerk/gecertificeerde-ondernemingen/53031c51-af37-418c-50aa-89f12b03879f/verklaring/nl" target="_blank" rel="noopener" title="Verklaring Stichting Normering Arbeid">SNA gecertificeerd (NEN 4400-1)</a></p>
        </div>
        <div class="voet__kolom voet__kolom--smal">
          <p class="label label--stil">Site</p>
          {nav.map(([href, naam]) => <a href={href}>{naam}</a>)}
          <a href="/privacy">Privacy</a>
        </div>
        <div class="voet__kolom voet__kolom--smal">
          <p class="label label--stil">Groep</p>
          <a href="https://itbrouwerij.nl" target="_blank" rel="noopener">IT Brouwerij</a>
          <a href="https://techforce1.nl" target="_blank" rel="noopener">Techforce1</a>
          <a href="https://craftsmen.nl" target="_blank" rel="noopener">Craftsmen</a>
          <a href="https://codefoundry.nl" target="_blank" rel="noopener">Code Foundry</a>
        </div>
        <div class="voet__kolom voet__kolom--smal">
          <p class="label label--stil">Clouds</p>
          <a href="/#clouds">Azure</a>
          <a href="/#clouds">AWS</a>
          <a href="/#clouds">Google Cloud</a>
        </div>
        <div class="voet__kolom voet__kolom--smal">
          <p class="label label--stil">Volg ons</p>
          <a href="https://www.linkedin.com/company/myst" target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <div class="voet__kolom">
          <p class="label label--stil">Hoe deze site is gebouwd</p>
          <a href="/gebouwd">Lees hoe →</a>
        </div>
      </div>
      <div class="wrap voet__build">
        <span>build {buildHash} · {buildDatum} · 0 cookies</span>
        <span><a href="https://shell.myst.nl" target="_blank" rel="noopener">press ~ for console</a></span>
      </div>
    </footer>
    <Toast />
    <script>
      import logo from "../ascii-logo.txt?raw";

      // Dit bestand wordt één keer per paginabezoek uitgevoerd; ClientRouter laadt het niet opnieuw.
      console.log("%c" + logo, "color:#E8008A; font-family:monospace; font-size:12px; line-height:1.2");
      console.log("%cJe kijkt onder de motorkap. Dat waarderen we.\nBenieuwd wat er nog meer te vinden is? https://shell.myst.nl", "color:#5CA0FF; font-family:monospace; font-size:12px");

      function fades() {
        const els = document.querySelectorAll<HTMLElement>(".fade:not(.zichtbaar)");
        if (!("IntersectionObserver" in window)) return els.forEach((e) => e.classList.add("zichtbaar"));
        const io = new IntersectionObserver((items) => {
          for (const i of items) {
            if (i.isIntersecting) {
              i.target.classList.add("zichtbaar");
              io.unobserve(i.target);
            }
          }
        }, { threshold: 0.05, rootMargin: "0px 0px -10% 0px" });
        els.forEach((e) => io.observe(e));
      }
      function direct(hash: string) {
        if (hash.length < 2) return;
        const doel = document.getElementById(decodeURIComponent(hash.slice(1)))?.closest<HTMLElement>(".fade");
        if (doel) doel.classList.add("zichtbaar", "direct");
      }
      document.addEventListener("astro:page-load", () => {
        direct(location.hash);
        fades();
      });
      document.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href*='#']");
        if (a && a.pathname === location.pathname) direct(a.hash);
      });
      window.addEventListener("hashchange", () => direct(location.hash));

      document.addEventListener("keydown", (e) => {
        if (!(e.key === "~" || (e.code === "Backquote" && e.shiftKey))) return;
        const t = e.target as HTMLElement;
        if (t.matches("input, textarea, select")) return;
        e.preventDefault();
        window.open("https://shell.myst.nl", "_blank", "noopener");
      });
    </script>
  </body>
</html>
