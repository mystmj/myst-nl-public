---
import Base from "../layouts/Base.astro";
import Label from "../components/Label.astro";
import Engineers from "../components/Engineers.astro";
---
<Base title="Engineers · Myst" description="Een klein team senior cloud engineers, bewust niet groter dan 25.">
  <div class="wrap pagina-kop">
    <Label>de engineers</Label>
    <h1>Wie hier bouwen</h1>
    <p>Een klein team, bewust niet groter dan 25. Ieder gespecialiseerd in één cloud, thuis in de andere twee. Geen foto's: het werk zegt genoeg.</p>
  </div>
  <section class="wrap sectie fade eind"><h2 class="sr-only">Engineers</h2><Engineers /></section>
</Base>
